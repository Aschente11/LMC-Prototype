[gd_scene load_steps=4 format=3 uid="uid://bskgu07l8xscv"]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

@onready var text_label = $Document/MarginContainer/VBoxContainer/TextLabel

var essay_text = \"\"\"Let Me Cook!: A Virtual Reality Game Exploring ADHD Symptomatology Through Routine Activities
Ann Colleen Garcia, Almira Princess Redoble, Gerick Jeremiah Niño N. Go, Eric Cesar E. Vidal, Jr.

Persons with Attention-Deficit/Hyperactivity Disorder (ADHD) are neglected in the Philippines. This is due to the lack of official statistical data on the number of people affected by ADHD, as well as the lack of awareness and prevalent misunderstanding of the disorder, according to the National Council on Disability Affairs [1]. This is exacerbated by the inadequate number of mental health professionals in the country [2].
ADHD is one of the most common neurodevelopmental disorders diagnosed in children [3]. As a disorder, it is identified via the executive dysfunction it causes, such as issues with working memory and poor organizational skills, leading to difficulties in obtaining and maintaining jobs, increased vulnerability to anxiety, and impaired driving safety [4], [5].
This paper addresses the lack of ADHD awareness by developing a virtual reality (VR) empathy game, entitled \"Let Me Cook!\". The game is designed to promote understanding of ADHD symptomatology through the simulation of everyday routines.
\"\"\"

var current_text = \"\"
var char_index = 0
var typing_speed = 3
var typing_timer = 0.0
var is_typing_active = false  # Controlled by keyboard striking

func _ready():
	# Connect to the global typing controller signals
	TypingManager.typing_started.connect(_on_typing_started)
	TypingManager.typing_stopped.connect(_on_typing_stopped)
	set_process(true)

func _on_typing_started():
	is_typing_active = true
	typing_timer = typing_speed 
	
func _on_typing_stopped():
	is_typing_active = false

func _process(delta):
	# Only type when player is striking the keyboard
	if is_typing_active and char_index < essay_text.length():
		typing_timer += delta
		if typing_timer >= typing_speed:
			typing_timer = 0.0
			current_text += essay_text[char_index]
			text_label.text = current_text
			char_index += 1
			
			# Vary typing speed slightly for realism
			typing_speed = randf_range(0.03, 0.08)
			
			# Longer pause after punctuation (only if not at the end)
			if char_index < essay_text.length():
				if essay_text[char_index - 1] in ['.', '!', '?']:
					typing_speed = 0.3
				elif essay_text[char_index - 1] == ',':
					typing_speed = 0.15
	
"

