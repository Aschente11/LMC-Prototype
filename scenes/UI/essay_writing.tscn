[gd_scene load_steps=4 format=3 uid="uid://bskgu07l8xscv"]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

@onready var text_label = $Document/MarginContainer/VBoxContainer/TextLabel
@onready var cursor = $Document/MarginContainer/VBoxContainer/Cursor

var essay_text = \"The Impact of Technology on Modern Society

Technology has fundamentally transformed the way we live, work, and communicate. In the 21st century, digital innovations have become an integral part of our daily lives, reshaping everything from education to entertainment.

The rise of the internet has connected people across the globe, breaking down geographical barriers and creating new opportunities for collaboration. Social media platforms have revolutionized how we share information and maintain relationships, though they also present challenges regarding privacy and mental health.

In the workplace, automation and artificial intelligence are changing the nature of employment. While these technologies increase efficiency and productivity, they also raise important questions about the future of work and the skills workers will need to thrive in an increasingly digital economy.

Education has also been transformed by technology. Online learning platforms provide access to knowledge for people who might not have had educational opportunities otherwise. However, the digital divide remains a significant concern, as not everyone has equal access to these technological resources.

As we continue to advance technologically, it is crucial that we consider both the benefits and the challenges these innovations bring to our society.\"

var current_text = \"\"
var char_index = 0
var typing_speed = 0.05
var typing_timer = 0.0
var cursor_blink_timer = 0.0
var cursor_visible = true

func _ready():
	set_process(true)

func _process(delta):
	# Typing animation
	if char_index < essay_text.length():
		typing_timer += delta
		if typing_timer >= typing_speed:
			typing_timer = 0.0
			current_text += essay_text[char_index]
			text_label.text = current_text
			char_index += 1
			# Vary typing speed slightly for realism
			typing_speed = randf_range(0.03, 0.08)
			# Longer pause after punctuation
			if essay_text[char_index - 1] in ['.', '!', '?']:
				typing_speed = 0.3
			elif essay_text[char_index - 1] == ',':
				typing_speed = 0.15
	
	# Cursor blinking
	cursor_blink_timer += delta
	if cursor_blink_timer >= 0.5:
		cursor_blink_timer = 0.0
		cursor_visible = !cursor_visible
		cursor.visible = cursor_visible and char_index < essay_text.length()
"

